# Copy to frontend/.env.local for `npm run dev`.

# REST calls go through the Next.js /api proxy (next.config.js), which
# also makes the app usable from other devices on the LAN.
NEXT_PUBLIC_API_URL=/api

# Backend as seen from the browser: images and the chat WebSocket.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Backend as seen from the Next.js server (target of the /api proxy).
# BACKEND_INTERNAL_URL=http://localhost:3001
