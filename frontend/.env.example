# Copy to frontend/.env.local for `npm run dev`.

# REST calls go through the Next.js /api proxy (next.config.js), which
# also makes the app usable from other devices on the LAN.
#
# Development only. The proxy does not pass the visitor's IP on, so the
# backend sees every guest as one address and they all share one rate-limit
# bucket. For a real deployment leave this unset: the browser then calls
# NEXT_PUBLIC_BACKEND_URL/api directly (that is what the Docker image does).
NEXT_PUBLIC_API_URL=/api

# Backend as seen from the browser: REST API (unless proxied, see above),
# images and the chat WebSocket.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Backend as seen from the Next.js server (target of the /api proxy).
# BACKEND_INTERNAL_URL=http://localhost:3001
