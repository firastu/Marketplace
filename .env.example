# Copy to .env (project root). Read by docker-compose.yml and by the
# database scripts in database/scripts/.

# PostgreSQL (host port 5433 so it doesn't clash with a local Postgres)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_secret
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5433

# Only needed for `docker compose --profile app up` (whole stack in Docker)
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Browser-facing URLs
PUBLIC_BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
# BACKEND_PORT=3001
# FRONTEND_PORT=3000
# Set to 1 when running behind one reverse proxy (nginx, Cloudflare, ...)
# TRUST_PROXY=1
