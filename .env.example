# Copy to .env (project root). Read by docker-compose.yml and by the
# database scripts in database/scripts/.

# PostgreSQL (host port 5433 so it doesn't clash with a local Postgres)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_secret
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5433

# Only needed for `docker compose --profile app up` (whole stack in Docker)
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Browser-facing URLs
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
# Lets the web app's server-side rendering call the API without being
# rate-limited as one guest. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
# Email for password reset (an EU provider keeps data in the EU for GDPR).
# Without SMTP_HOST, emails are only written to the backend log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Marketplace <no-reply@example.com>"
# ENABLE_SWAGGER=false
# BACKEND_PORT=3001
# FRONTEND_PORT=3000
# Set to 1 when running behind one reverse proxy (nginx, Cloudflare, ...)
# TRUST_PROXY=1
