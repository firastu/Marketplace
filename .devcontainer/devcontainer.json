{
  // GitHub Codespaces / dev container for demos and development.
  // Demo: open a codespace, then run `bash scripts/codespace-demo.sh`.
  "name": "Marketplace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": { "label": "Web app", "onAutoForward": "notify" },
    "3001": { "label": "API", "onAutoForward": "silent" }
  },
  "postAttachCommand": "echo 'Demo: run  bash scripts/codespace-demo.sh  to start the whole app with a database.'"
}
