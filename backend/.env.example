# Copy to backend/.env for `npm run start:dev`.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_secret
POSTGRES_DB=marketplace_db

# Required — the API refuses to start without it. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads

# Comma-separated origins allowed to call the API and open WebSockets.
# Default: http://localhost:3000. Use * only for LAN testing from a phone.
CORS_ORIGINS=http://localhost:3000

# Behind a reverse proxy, set how many proxy hops to trust so rate limiting
# sees the real client IP (e.g. 1 for nginx in front of the API).
# TRUST_PROXY=1

# Rate limits per minute. Logged-in users are counted per account,
# guests per IP (many Syrian mobile users share one IP via carrier NAT).
# THROTTLE_LIMIT=300        # any route
# THROTTLE_AUTH_LIMIT=20    # login / register
# THROTTLE_WRITE_LIMIT=60   # create listing, upload, send message, review
# THROTTLE_DISABLED=false

# Public address of the web app; password-reset links point here.
APP_URL=http://localhost:3000

# Shared secret: requests from the web app's server (server-side rendering)
# that send it in the X-Internal-Key header skip rate limiting.
# INTERNAL_API_KEY=

# Email (password reset). Without SMTP_HOST, emails are logged instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Marketplace <no-reply@example.com>"

# API docs at /api/docs: on by default in development, off in production
# unless this is true.
# ENABLE_SWAGGER=false

# Days before photos of deleted listings are removed for good (GDPR).
# LISTING_RETENTION_DAYS=30
